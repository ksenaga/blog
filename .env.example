# このファイルを .env にコピーして使う（.env は Git に含めない）
# cp .env.example .env

# DB
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog

# 画像の保存先
# ローカル開発では compose.yml で STORAGE_DRIVER=local（Docker のボリューム）を指定している。
# 本番で S3 に切り替えるときは、以下を設定する。
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=ap-northeast-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# IMAGE_BASE_URL=https://（CDN などのURL）

# JWT（本番では十分に長いランダムな文字列にする）
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ログイン試行の制限
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 画像
IMAGE_MAX_SIZE_MB=10
IMAGE_MAX_PER_BLOG=20
IMAGE_MAX_LONG_EDGE_PX=1600
